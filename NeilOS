from flask import Flask, request, jsonify
import sqlite3
from werkzeug.security import generate_password_hash, check_password_hash

app = Flask(__name__)

def db():
    return sqlite3.connect("neilos.db")

# -------- INIT DB --------
def init():
    conn = db()
    conn.execute("CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY, username TEXT, password TEXT)")
    conn.execute("CREATE TABLE IF NOT EXISTS bank(id INTEGER PRIMARY KEY, balance REAL)")
    conn.execute("CREATE TABLE IF NOT EXISTS messages(message TEXT)")
    conn.execute("CREATE TABLE IF NOT EXISTS employees(name TEXT, salary REAL)")
    conn.execute("CREATE TABLE IF NOT EXISTS patients(data TEXT)")
    conn.execute("INSERT OR IGNORE INTO bank(id,balance) VALUES(1,1000)")
    conn.commit()
    conn.close()

init()

# -------- AUTH --------
@app.route("/register", methods=["POST"])
def register():
    d = request.json
    conn = db()
    conn.execute("INSERT INTO users(username,password) VALUES(?,?)",
                 (d["username"], generate_password_hash(d["password"])))
    conn.commit()
    conn.close()
    return jsonify(message="Registered")

@app.route("/login", methods=["POST"])
def login():
    d = request.json
    conn = db()
    cur = conn.execute("SELECT password FROM users WHERE username=?", (d["username"],))
    row = cur.fetchone()
    conn.close()
    return jsonify(success=(row and check_password_hash(row[0], d["password"])))

# -------- BANK --------
@app.route("/balance")
def balance():
    conn = db()
    bal = conn.execute("SELECT balance FROM bank WHERE id=1").fetchone()[0]
    conn.close()
    return jsonify(balance=bal)

@app.route("/deposit", methods=["POST"])
def deposit():
    amt = float(request.json["amount"])
    conn = db()
    conn.execute("UPDATE bank SET balance = balance + ?", (amt,))
    conn.commit()
    conn.close()
    return balance()

@app.route("/withdraw", methods=["POST"])
def withdraw():
    amt = float(request.json["amount"])
    conn = db()
    bal = conn.execute("SELECT balance FROM bank WHERE id=1").fetchone()[0]
    if bal >= amt:
        conn.execute("UPDATE bank SET balance = balance - ?", (amt,))
        conn.commit()
    conn.close()
    return balance()

# -------- CHAT --------
@app.route("/chat", methods=["POST"])
def chat():
    msg = request.json["message"]
    conn = db()
    conn.execute("INSERT INTO messages VALUES(?)", (msg,))
    conn.commit()
    conn.close()
    return jsonify(message="Sent")

@app.route("/chat")
def get_chat():
    conn = db()
    data = [r[0] for r in conn.execute("SELECT message FROM messages")]
    conn.close()
    return jsonify(data)

app.run(port=5002)
