<style>
body {
    margin: 0;
    font-family: 'Segoe UI', Arial, sans-serif;
    color: white;
    overflow: hidden;
    height: 100vh;
}

/* ── Animated background canvas ── */
#bgCanvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
}

/* Gradient overlay on top of canvas */
.bg-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at 30% 20%, rgba(56,189,248,0.12) 0%, transparent 60%),
                radial-gradient(ellipse at 80% 80%, rgba(139,92,246,0.10) 0%, transparent 50%);
    z-index: 1;
    pointer-events: none;
}

/* Desktop */
.desktop {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    padding: 30px;
    gap: 24px;
    align-content: flex-start;
    height: calc(100vh - 56px);
}

/* Icons */
.icon {
    width: 80px;
    text-align: center;
    cursor: pointer;
    transition: transform 0.2s, filter 0.2s;
    user-select: none;
}
.icon:hover {
    transform: translateY(-4px) scale(1.08);
    filter: drop-shadow(0 4px 12px rgba(56,189,248,0.45));
}
.icon div {
    font-size: 42px;
}
.icon span {
    display: block;
    margin-top: 6px;
    font-size: 12px;
    text-shadow: 0 1px 4px rgba(0,0,0,0.7);
}

/* Window */
.window {
    position: absolute;
    top: 100px;
    left: 100px;
    width: 320px;
    background: rgba(30,41,59,0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    display: none;
    padding: 14px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.45);
    z-index: 10;
}
.window header {
    font-weight: bold;
    margin-bottom: 10px;
    cursor: move;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
input, button {
    width: 100%;
    margin: 5px 0;
    padding: 8px 10px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
    box-sizing: border-box;
}
input {
    background: rgba(15,23,42,0.7);
    color: #e2e8f0;
    border: 1px solid rgba(255,255,255,0.1);
}
input:focus {
    outline: none;
    border-color: #38bdf8;
    box-shadow: 0 0 0 2px rgba(56,189,248,0.25);
}
button {
    background: linear-gradient(135deg, #38bdf8, #818cf8);
    color: white;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.15s;
}
button:hover {
    opacity: 0.9;
    transform: translateY(-1px);
}
button:active {
    transform: translateY(0);
}
pre {
    background: rgba(0,0,0,0.5);
    padding: 8px;
    height: 100px;
    overflow: auto;
    border-radius: 6px;
    font-size: 12px;
    border: 1px solid rgba(255,255,255,0.05);
}

/* ── Taskbar ── */
.taskbar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 48px;
    background: rgba(15,23,42,0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid rgba(255,255,255,0.08);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0 16px;
}
.taskbar-clock {
    position: absolute;
    right: 18px;
    font-size: 12px;
    color: #94a3b8;
}
.taskbar-btn {
    width: auto;
    padding: 4px 14px;
    margin: 0;
    font-size: 18px;
    background: transparent;
    border-radius: 8px;
    transition: background 0.2s;
    cursor: pointer;
}
.taskbar-btn:hover {
    background: rgba(255,255,255,0.1);
    transform: none;
}
</style>
</head>

