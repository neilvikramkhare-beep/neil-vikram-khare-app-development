}
//server.sql
CREATE TABLE users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT,
    password TEXT
);

CREATE TABLE bank ( id INTEGER PRIMARY KEY, balance REAL );

INSERT INTO bank VALUES (1, 1000);

CREATE TABLE messages (message TEXT);

CREATE TABLE employees (name TEXT, salary REAL);

CREATE TABLE patients (data TEXT);
//server.py
from flask import Flask, request, jsonify
import sqlite3
from werkzeug.security import generate_password_hash, check_password_hash

app = Flask(__name__)

# -------- DATABASE --------
def db():
    return sqlite3.connect("neilos.db")


# -------- INIT DB --------
def init():
    conn = db()

    conn.execute("""
        CREATE TABLE IF NOT EXISTS users(
            id INTEGER PRIMARY KEY,
            username TEXT,
            password TEXT
        )
    """)

    conn.execute("""
        CREATE TABLE IF NOT EXISTS bank(
            id INTEGER PRIMARY KEY,
            balance REAL
        )
    """)

    conn.execute("""
        CREATE TABLE IF NOT EXISTS messages(
            message TEXT
        )
    """)

    conn.execute("""
        CREATE TABLE IF NOT EXISTS employees(
            name TEXT,
            salary REAL
        )
    """)

    conn.execute("""
        CREATE TABLE IF NOT EXISTS patients(
            data TEXT
        )
    """)

    conn.execute("INSERT OR IGNORE INTO bank(id, balance) VALUES(1, 1000)")

    conn.commit()
    conn.close()


init()


# -------- AUTH --------
@app.route("/register", methods=["POST"])
def register():
    d = request.json
    conn = db()

    conn.execute(
        "INSERT INTO users(username, password) VALUES(?, ?)",
        (d["username"], generate_password_hash(d["password"]))
    )

    conn.commit()
    conn.close()

    return jsonify(message="Registered")


@app.route("/login", methods=["POST"])
def login():
    d = request.json
    conn = db()

    cur = conn.execute(
        "SELECT password FROM users WHERE username=?",
        (d["username"],)
    )

    row = cur.fetchone()
    conn.close()

    return jsonify(success=(row and check_password_hash(row[0], d["password"])))


# -------- BANK --------
@app.route("/balance")
def balance():
    conn = db()

    bal = conn.execute(
        "SELECT balance FROM bank WHERE id=1"
    ).fetchone()[0]

    conn.close()

    return jsonify(balance=bal)


@app.route("/deposit", methods=["POST"])
def deposit():
    amt = float(request.json["amount"])
    conn = db()

    conn.execute(
        "UPDATE bank SET balance = balance + ?",
        (amt,)
    )

    conn.commit()
    conn.close()

    return balance()


@app.route("/withdraw", methods=["POST"])
def withdraw():
    amt = float(request.json["amount"])
    conn = db()

    bal = conn.execute(
        "SELECT balance FROM bank WHERE id=1"
    ).fetchone()[0]

    if bal >= amt:
        conn.execute(
            "UPDATE bank SET balance = balance - ?",
            (amt,)
        )
        conn.commit()

    conn.close()

    return balance()


# -------- CHAT --------
@app.route("/chat", methods=["POST"])
def chat():
    msg = request.json["message"]
    conn = db()

    conn.execute(
        "INSERT INTO messages VALUES(?)",
        (msg,)
    )

    conn.commit()
    conn.close()

    return jsonify(message="Sent")


@app.route("/chat")
def get_chat():
    conn = db()

    data = [r[0] for r in conn.execute("SELECT message FROM messages")]
    conn.close()
    return jsonify(data)
    # -------- EMPLOYEES --------
@app.route("/employees", methods=["POST"])
def add_employee():
    d = request.json
    conn = db()
    conn.execute("INSERT INTO employees VALUES(?,?)", (d["name"], d["salary"]))
    conn.commit()
    conn.close()
    return jsonify(message="Employee added")

@app.route("/employees")
def get_employees():
    conn = db()
    data = [{"name": r[0], "salary": r[1]} for r in conn.execute("SELECT * FROM employees")]
    conn.close()
    return jsonify(data)


# -------- PATIENTS --------
@app.route("/patients", methods=["POST"])
def add_patient():
    d = request.json
    conn = db()
    conn.execute("INSERT INTO patients VALUES(?)", (d["data"],))
    conn.commit()
    conn.close()
    return jsonify(message="Patient added")

@app.route("/patients")
def get_patients():
    conn = db()
    data = [r[0] for r in conn.execute("SELECT data FROM patients")]
    conn.close()
    return jsonify(data)
if __name__ == "__main__":
    app.run(port=5002, debug=True)
    //server.java
    import org.springframework.web.bind.annotation.*;
import java.util.*;

@RestController
public class Backend {

    Map<String,String> users = new HashMap<>();
    double balance = 1000;
    List<String> chat = new ArrayList<>();

    @PostMapping("/register")
    public Map<String,String> register(@RequestBody Map<String,String> d){
        users.put(d.get("username"), d.get("password"));
        return Map.of("message","Registered");
    }

    @PostMapping("/login")
    public Map<String,Boolean> login(@RequestBody Map<String,String> d){
        boolean ok = users.containsKey(d.get("username")) &&
                     users.get(d.get("username")).equals(d.get("password"));
        return Map.of("success", ok);
    }

    @GetMapping("/balance")
    public Map<String,Double> balance(){
        return Map.of("balance", balance);
    }

    @PostMapping("/deposit")
    public Map<String,Double> deposit(@RequestBody Map<String,Double> d){
        balance += d.get("amount");
        return balance();
    }

    @PostMapping("/withdraw")
    public Map<String,Double> withdraw(@RequestBody Map<String,Double> d){
        if(balance >= d.get("amount")) balance -= d.get("amount");
        return balance();
    }

    @PostMapping("/chat")
    public Map<String,String> chat(@RequestBody Map<String,String> d){
        chat.add(d.get("message"));
        return Map.of("message","Sent");
    }

    @GetMapping("/chat")
    public List<String> getChat(){
        return chat;
    }
}
//server.cpp
#include "crow_all.h"
#include <vector>
#include <string>

int main() {
    crow::SimpleApp app;

    double balance = 1000;
    std::vector<std::string> chat;

    CROW_ROUTE(app, "/balance")
    ([](){
        crow::json::wvalue x;
        x["balance"] = 1000;
        return x;
    });

    CROW_ROUTE(app, "/deposit").methods("POST"_method)
    ([&balance](const crow::request& req){
        auto data = crow::json::load(req.body);
        balance += data["amount"].d();
        crow::json::wvalue x;
        x["balance"] = balance;
        return x;
    });

    CROW_ROUTE(app, "/chat").methods("POST"_method)
    ([&chat](const crow::request& req){
        auto data = crow::json::load(req.body);
        chat.push_back(data["message"].s());
        return crow::response("Sent");
    });

    app.port(5002).multithreaded().run();
}
//index.html
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>NeilOS</title>

    <style>
      /* -------- GLOBAL -------- */
      body {
        margin: 0;
        overflow: hidden;
        font-family: "Segoe UI", sans-serif;
        color: white;
        background: black;
      }

      /* -------- BOOT SCREEN -------- */
      #boot {
        position: fixed;
        width: 100%;
        height: 100%;
        background: black;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        z-index: 9999;
      }

      /* NeilOS symbol */
      #logo {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: radial-gradient(circle, #00ffd5, #003333);
        box-shadow:
          0 0 40px #00ffd5,
          0 0 80px #00ffd5;
        animation: pulse 2s infinite alternate;
      }

      @keyframes pulse {
        from {
          transform: scale(1);
        }
        to {
          transform: scale(1.2);
        }
      }

      #bootText {
        margin-top: 20px;
        font-size: 24px;
        letter-spacing: 2px;
        color: #00ffd5;
      }

      /* -------- BACKGROUND (PARROT STYLE) -------- */
      #bg {
        position: fixed;
        width: 100%;
        height: 100%;
        z-index: -1;
        overflow: hidden;
      }

      .layer {
        position: absolute;
        width: 200%;
        height: 200%;
        top: -50%;
        left: -50%;
        background:
          radial-gradient(circle, rgba(0, 255, 200, 0.15), transparent 60%),
          linear-gradient(120deg, #001a1a, #000, #001a1a);
        animation: rotate 30s linear infinite;
      }

      .wave {
        position: absolute;
        width: 200%;
        height: 200%;
        border-radius: 40%;
        background: rgba(0, 255, 200, 0.05);
        animation: waveMove 15s ease-in-out infinite alternate;
      }

      .wave:nth-child(2) {
        animation-duration: 20s;
        background: rgba(0, 150, 255, 0.05);
      }

      .wave:nth-child(3) {
        animation-duration: 25s;
        background: rgba(0, 255, 150, 0.05);
      }

      @keyframes rotate {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }

      @keyframes waveMove {
        0% {
          transform: translate(-10%, -10%) scale(1);
        }
        100% {
          transform: translate(10%, 10%) scale(1.2);
        }
      }

      /* -------- DESKTOP -------- */
      #desktop {
        padding: 20px;
        display: none;
      }

      #title {
        font-size: 34px;
        font-weight: bold;
        color: #00ffd5;
        text-shadow: 0 0 20px #00ffd5;
      }

      /* -------- ICONS -------- */
      .icon {
        width: 90px;
        text-align: center;
        cursor: pointer;
        margin: 20px;
        display: inline-block;
        transition: 0.2s;
      }

      .icon img {
        width: 64px;
      }

      .icon:hover {
        transform: scale(1.15);
        filter: drop-shadow(0 0 10px cyan);
      }

      /* -------- WINDOWS -------- */
      .window {
        position: absolute;
        top: 120px;
        left: 120px;
        width: 320px;
        background: rgba(0, 0, 0, 0.8);
        border: 1px solid #00ffd5;
        border-radius: 12px;
        backdrop-filter: blur(10px);
        display: none;
        padding: 10px;
        box-shadow: 0 0 20px rgba(0, 255, 200, 0.4);
      }

      .window-header {
        font-weight: bold;
        margin-bottom: 10px;
        color: #00ffd5;
      }

      /* Inputs */
      input,
      button {
        width: 100%;
        margin: 6px 0;
        padding: 6px;
        border: none;
        border-radius: 5px;
      }

      button {
        background: #00ffd5;
        color: black;
        font-weight: bold;
        cursor: pointer;
      }

      button:hover {
        background: #00c2a8;
      }

      #chatBox {
        height: 120px;
        overflow-y: auto;
        background: #111;
        padding: 5px;
      }

      /* Lists */
      .list {
        max-height: 120px;
        overflow-y: auto;
        background: #111;
        padding: 5px;
      }
    </style>
  </head>

  <body>
    <!-- BOOT -->
    <div id="boot">
      <div id="logo"></div>
      <div id="bootText">Starting NeilOS...</div>
    </div>

    <!-- BACKGROUND -->
    <div id="bg">
      <div class="layer"></div>
      <div class="wave"></div>
      <div class="wave"></div>
      <div class="wave"></div>
    </div>

    <!-- DESKTOP -->
    <div id="desktop">
      <div id="title">⚡ NeilOS</div>

      <div class="icon" onclick="openApp('auth')">
        <img src="https://cdn-icons-png.flaticon.com/512/3064/3064155.png" />
        <div>Auth</div>
      </div>

      <div class="icon" onclick="openApp('bank')">
        <img src="https://img.icons8.com/fluency/96/bank.png" />
        <div>Bank</div>
      </div>

      <div class="icon" onclick="openApp('chat')">
        <img src="https://img.icons8.com/fluency/96/chat.png" />
        <div>Chat</div>
      </div>

      <div class="icon" onclick="openApp('employees')">
        <img src="https://img.icons8.com/fluency/96/conference.png" />
        <div>Employees</div>
      </div>

      <div class="icon" onclick="openApp('patients')">
        <img src="https://img.icons8.com/fluency/96/hospital.png" />
        <div>Patients</div>
      </div>
    </div>

    <!-- WINDOWS -->

    <div class="window" id="auth">
      <div class="window-header">Auth</div>
      <input id="user" placeholder="Username" />
      <input id="pass" type="password" placeholder="Password" />
      <button onclick="register()">Register</button>
      <button onclick="login()">Login</button>
      <div id="authResult"></div>
    </div>

    <div class="window" id="bank">
      <div class="window-header">Bank</div>
      <button onclick="getBalance()">Check Balance</button>
      <input id="amount" placeholder="Amount" />
      <button onclick="deposit()">Deposit</button>
      <button onclick="withdraw()">Withdraw</button>
      <div id="bankResult"></div>
    </div>

    <div class="window" id="chat">
      <div class="window-header">Chat</div>
      <div id="chatBox"></div>
      <input id="msg" placeholder="Message" />
      <button onclick="sendMsg()">Send</button>
    </div>

    <div class="window" id="employees">
      <div class="window-header">Employees</div>
      <input id="empName" placeholder="Name" />
      <input id="empSalary" placeholder="Salary" />
      <button onclick="addEmployee()">Add</button>
      <div id="empList" class="list"></div>
    </div>

    <div class="window" id="patients">
      <div class="window-header">Patients</div>
      <input id="patientData" placeholder="Patient Info" />
      <button onclick="addPatient()">Add</button>
      <div id="patientList" class="list"></div>
    </div>

    <script>
      const API = "http://127.0.0.1:5002";

      /* Boot animation */
      setTimeout(() => {
        document.getElementById("boot").style.display = "none";
        document.getElementById("desktop").style.display = "block";
      }, 2500);

      /* window control */
      function openApp(id) {
        document
          .querySelectorAll(".window")
          .forEach((w) => (w.style.display = "none"));
        document.getElementById(id).style.display = "block";
      }

      /* AUTH */
      async function register() {
        let res = await fetch(API + "/register", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ username: user.value, password: pass.value }),
        });
        let d = await res.json();
        authResult.innerText = d.message;
      }

      async function login() {
        let res = await fetch(API + "/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ username: user.value, password: pass.value }),
        });
        let d = await res.json();
        authResult.innerText = d.success ? "Login Success" : "Failed";
      }

      /* BANK */
      async function getBalance() {
        let d = await (await fetch(API + "/balance")).json();
        bankResult.innerText = "Balance: " + d.balance;
      }

      async function deposit() {
        let d = await (
          await fetch(API + "/deposit", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ amount: amount.value }),
          })
        ).json();
        bankResult.innerText = "Balance: " + d.balance;
      }

      async function withdraw() {
        let d = await (
          await fetch(API + "/withdraw", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ amount: amount.value }),
          })
        ).json();
        bankResult.innerText = "Balance: " + d.balance;
      }

      /* CHAT */
      async function sendMsg() {
        await fetch(API + "/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ message: msg.value }),
        });
        loadChat();
      }

      async function loadChat() {
        let d = await (await fetch(API + "/chat")).json();
        chatBox.innerHTML = d.map((m) => "<div>" + m + "</div>").join("");
      }

      /* EMPLOYEES */
      async function addEmployee() {
        await fetch(API + "/employees", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: empName.value,
            salary: empSalary.value,
          }),
        });
        loadEmployees();
      }

      async function loadEmployees() {
        let d = await (await fetch(API + "/employees")).json();
        empList.innerHTML = d
          .map((e) => `<div>${e.name} - ₹${e.salary}</div>`)
          .join("");
      }

      /* PATIENTS */
      async function addPatient() {
        await fetch(API + "/patients", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ data: patientData.value }),
        });
        loadPatients();
      }

      async function loadPatients() {
        let d = await (await fetch(API + "/patients")).json();
        patientList.innerHTML = d.map((p) => `<div>${p}</div>`).join("");
      }

      /* auto refresh */
      setInterval(() => {
        loadChat();
        loadEmployees();
        loadPatients();
      }, 2000);
    </script>
  </body>
</html>
