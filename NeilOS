/* ── BLAST Background Animation ── */
(function() {
    const canvas = document.getElementById('bgCanvas');
    const ctx = canvas.getContext('2d');
    let w, h;

    function resize() {
        w = canvas.width = window.innerWidth;
        h = canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    /* ── Colour palette ── */
    const COLORS = [
        [56,189,248],   // sky blue
        [139,92,246],   // violet
        [236,72,153],   // pink
        [251,191,36],   // amber
        [52,211,153],   // emerald
        [255,255,255],  // white
    ];

    /* ── Blast (burst) particles ── */
    const BURST_COUNT = 260;
    const burstParticles = [];
    const cx = () => w / 2;
    const cy = () => h / 2;

    for (let i = 0; i < BURST_COUNT; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 2 + Math.random() * 10;
        const c = COLORS[Math.floor(Math.random() * COLORS.length)];
        burstParticles.push({
            x: cx(), y: cy(),
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            r: Math.random() * 3 + 1,
            color: c,
            alpha: 1,
            decay: 0.003 + Math.random() * 0.006,
            trail: []
        });
    }

    /* ── Shockwave ring ── */
    let shockRadius = 0;
    let shockAlpha = 1.2;
    const SHOCK_SPEED = 8;

    /* ── Screen flash ── */
    let flashAlpha = 1.0;

    /* ── Ambient (post-blast) particles ── */
    const ambientParticles = [];
    function seedAmbient() {
        const count = Math.floor((w * h) / 3500);
        ambientParticles.length = 0;
        for (let i = 0; i < count; i++) {
            const c = COLORS[Math.floor(Math.random() * COLORS.length)];
            ambientParticles.push({
                x: Math.random() * w,
                y: Math.random() * h,
                r: Math.random() * 1.6 + 0.3,
                dx: (Math.random() - 0.5) * 0.25,
                dy: (Math.random() - 0.5) * 0.12,
                color: c,
                alpha: 0,                        // fade-in after blast
                targetAlpha: Math.random() * 0.5 + 0.15,
                pulse: Math.random() * Math.PI * 2
            });
        }
    }
    seedAmbient();
    window.addEventListener('resize', seedAmbient);

    /* ── Nebula glow spots ── */
    const glows = [
        { x: 0.25, y: 0.3, rFactor: 0.35, color: '56,189,248', alpha: 0 },
        { x: 0.75, y: 0.7, rFactor: 0.30, color: '139,92,246', alpha: 0 },
        { x: 0.5,  y: 0.5, rFactor: 0.50, color: '236,72,153', alpha: 0 }
    ];

    /* ── Timing ── */
    const startTime = performance.now();
    const BLAST_DURATION = 3500;  // ms the blast fully plays

    /* ── Main draw loop ── */
    function draw() {
        const elapsed = performance.now() - startTime;
        const blastProgress = Math.min(elapsed / BLAST_DURATION, 1); // 0 → 1

        /* — background — */
        const grad = ctx.createLinearGradient(0, 0, w, h);
        grad.addColorStop(0, '#070b14');
        grad.addColorStop(0.5, '#0f172a');
        grad.addColorStop(1, '#070b14');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, w, h);

        /* — nebula glows (fade in after blast) — */
        for (const g of glows) {
            g.alpha += (0.08 - g.alpha) * 0.005;
            const rg = ctx.createRadialGradient(
                g.x * w, g.y * h, 0,
                g.x * w, g.y * h, g.rFactor * Math.max(w, h)
            );
            rg.addColorStop(0, `rgba(${g.color},${g.alpha})`);
            rg.addColorStop(1, 'transparent');
            ctx.fillStyle = rg;
            ctx.fillRect(0, 0, w, h);
        }

        /* — Ambient particles (fade-in gently after blast settles) — */
        for (const p of ambientParticles) {
            if (blastProgress > 0.4) {
                p.alpha += (p.targetAlpha - p.alpha) * 0.01;
            }
            p.pulse += 0.008;
            const flicker = 0.6 + 0.4 * Math.sin(p.pulse);
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(${p.color[0]},${p.color[1]},${p.color[2]},${p.alpha * flicker})`;
            ctx.fill();

            p.x += p.dx;
            p.y += p.dy;
            if (p.x < -5) p.x = w + 5;
            if (p.x > w + 5) p.x = -5;
            if (p.y < -5) p.y = h + 5;
            if (p.y > h + 5) p.y = -5;
        }

        /* — Burst particles (the main blast!) — */
        if (blastProgress < 1) {
            for (const bp of burstParticles) {
                // Trail memory
                bp.trail.push({ x: bp.x, y: bp.y, a: bp.alpha });
                if (bp.trail.length > 12) bp.trail.shift();

                // Draw trail
                for (let t = 0; t < bp.trail.length; t++) {
                    const seg = bp.trail[t];
                    const ta = seg.a * (t / bp.trail.length) * 0.35;
                    ctx.beginPath();
                    ctx.arc(seg.x, seg.y, bp.r * 0.6, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(${bp.color[0]},${bp.color[1]},${bp.color[2]},${ta})`;
                    ctx.fill();
                }

                // Draw head
                ctx.beginPath();
                ctx.arc(bp.x, bp.y, bp.r, 0, Math.PI * 2);
                const headGlow = ctx.createRadialGradient(bp.x, bp.y, 0, bp.x, bp.y, bp.r * 3);
                headGlow.addColorStop(0, `rgba(${bp.color[0]},${bp.color[1]},${bp.color[2]},${bp.alpha})`);
                headGlow.addColorStop(1, `rgba(${bp.color[0]},${bp.color[1]},${bp.color[2]},0)`);
                ctx.fillStyle = headGlow;
                ctx.fill();

                // Physics
                bp.x += bp.vx;
                bp.y += bp.vy;
                bp.vx *= 0.985;
                bp.vy *= 0.985;
                bp.alpha = Math.max(0, bp.alpha - bp.decay);
            }
        }

        /* — Shockwave ring — */
        if (shockAlpha > 0.01) {
            shockRadius += SHOCK_SPEED;
            shockAlpha *= 0.975;

            ctx.beginPath();
            ctx.arc(cx(), cy(), shockRadius, 0, Math.PI * 2);
            ctx.strokeStyle = `rgba(160,210,255,${shockAlpha * 0.6})`;
            ctx.lineWidth = 3 + shockAlpha * 6;
            ctx.shadowColor = 'rgba(56,189,248,0.8)';
            ctx.shadowBlur = 30 * shockAlpha;
            ctx.stroke();
            ctx.shadowBlur = 0;

            // second ring (slightly behind)
            if (shockRadius > 40) {
                ctx.beginPath();
                ctx.arc(cx(), cy(), shockRadius * 0.7, 0, Math.PI * 2);
                ctx.strokeStyle = `rgba(139,92,246,${shockAlpha * 0.35})`;
                ctx.lineWidth = 2 + shockAlpha * 3;
                ctx.stroke();
            }
        }

        /* — Screen flash overlay — */
        if (flashAlpha > 0.005) {
            ctx.fillStyle = `rgba(200,225,255,${flashAlpha})`;
            ctx.fillRect(0, 0, w, h);
            flashAlpha *= 0.94;
        }

        /* — Central glow (epicentre) — */
        if (blastProgress < 0.8) {
            const gIntensity = Math.max(0, 1 - blastProgress * 1.5);
            const cg = ctx.createRadialGradient(cx(), cy(), 0, cx(), cy(), 180);
            cg.addColorStop(0, `rgba(255,255,255,${gIntensity * 0.6})`);
            cg.addColorStop(0.3, `rgba(56,189,248,${gIntensity * 0.25})`);
            cg.addColorStop(1, 'transparent');
            ctx.fillStyle = cg;
            ctx.fillRect(cx() - 200, cy() - 200, 400, 400);
        }

        requestAnimationFrame(draw);
    }
    draw();
})();

/* ── Taskbar Clock ── */
(function() {
    const clock = document.getElementById('taskbar-clock');
    function tick() {
        const d = new Date();
        clock.textContent = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            + '  •  ' + d.toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' });
    }
    tick();
    setInterval(tick, 1000);
})();
</script>

