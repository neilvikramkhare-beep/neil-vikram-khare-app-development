<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cyber Risk Scanner</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body {
            margin: 0;
            font-family: 'Orbitron', monospace;
            background: url('data:image/jpeg;base64,') no-repeat center center fixed;
            background-size: cover;
            color: #00ff9c;
        }

        .overlay {
            position: fixed;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            z-index: 0;
        }

        .grid-bg {
            position: fixed;
            width: 100%;
            height: 100%;
            background-image:
                linear-gradient(#00ff9c22 1px, transparent 1px),
                linear-gradient(90deg, #00ff9c22 1px, transparent 1px);
            background-size: 40px 40px;
            animation: moveGrid 20s linear infinite;
            z-index: 1;
        }

        @keyframes moveGrid {
            from {
                transform: translateY(0);
            }

            to {
                transform: translateY(40px);
            }
        }

        .scan-line {
            position: fixed;
            width: 100%;
            height: 2px;
            background: #00ff9c;
            animation: scanMove 6s linear infinite;
            z-index: 2;
        }

        @keyframes scanMove {
            0% {
                top: 0;
            }

            100% {
                top: 100%;
            }
        }

        .container {
            position: relative;
            z-index: 3;
            background: rgba(0, 0, 0, 0.85);
            padding: 20px;
            margin: 20px auto;
            width: 500px;
            border-radius: 10px;
            border: 1px solid #00ff9c;
        }

        input,
        button,
        textarea {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            background: black;
            color: #00ff9c;
            border: 1px solid #00ff9c;
        }

        button {
            cursor: pointer;
        }

        pre {
            background: #000;
            padding: 10px;
            border: 1px solid #00ff9c;
            overflow-x: auto;
        }
    </style>
</head>

<body>
    <div class="overlay"></div>
    <div class="grid-bg"></div>
    <div class="scan-line"></div>
    <div class="container">
        <h2>Login</h2>
        <form>
            <input type="text" placeholder="Username" required>
            <input type="password" placeholder="Password" required>
            <button type="submit">Login</button>
        </form>
    </div>
    <p style="position:relative;z-index:3;padding:20px;">
    <div class="container">
        <h2>System Vulnerability Scanner</h2>
        <p> A vulnerability assessment is a systematic process of identifying, quantifying, and prioritizing the
            security
            vulnerabilities in an information system.
            A cyber vulnerability is a weakness in an IT system, process, or internal control that can be exploited by
            attackers to gain unauthorized access, steal data, or disrupt operations.
            These flaws—ranging from software bugs and poor passwords to misconfigured networks—are the entry points for
            malware, ransomware, and data breaches.A system vulnerability scanner is a tool that scans a system for
            vulnerabilities and threats.
            It analyzes the system to determine if there are any vulnerabilities or threats that need to be addressed.
        </p>
        <input id="targetInput" placeholder="Enter IP or URL">
        <button onclick="scanSystem()">Scan</button>
        <pre id="systemResult"></pre>
    </div>
    <div class="container">
        <h2>URL Scanner</h2>
        <p>A URL scanner is a tool that checks a website for malicious content, such as malware, phishing scams, or
            other security threats.
            It analyzes the website's code, links, and behavior to determine if it is safe to visit.</p>
        <input id="urlInput" placeholder="Enter URL">
        <button onclick="scanUrl()">Scan</button>
        <pre id="urlResult"></pre>
    </div>
    <div class="container">
        <h2>Cybersecurity Scan Analysis</h2>
        <p>Cybersecurity scan analysis is the process of examining the results of a security scan to identify
            vulnerabilities and threats.
            It involves analyzing the scan results to determine if there are any vulnerabilities or threats that need to
            be addressed.</p>
        <textarea id="scanData"></textarea>
        <button onclick="analyzeRisk()">Analyze</button>
        <pre id="analysisResult"></pre>
    </div>
    <div class="container">
        <h2>Data Breach Checker</h2>
        <p>A data breach checker is a tool that checks if your personal information has been exposed in a data breach.
            It analyzes your personal information to determine if it has been exposed in a data breach.</p>
        <input id="emailInput" placeholder="Enter email">
        <button onclick="checkBreach()">Check</button>
        <pre id="breachResult"></pre>
    </div>
    <div class="container">
        <h2>Website Security Scanner</h2>
        <p>A website security scanner is a tool that checks a website for malicious content, such as malware, phishing
            scams, or other security threats.
            It analyzes the website's code, links, and behavior to determine if it is safe to visit.</p>
        <input id="websiteInput" placeholder="Enter website URL">
        <button onclick="scanWebsite()">Scan</button>
        <pre id="websiteResult"></pre>
    </div>
    <div class="container">
        <h2>Network Scanner</h2>
        <p>A network scanner is a tool that scans a network for active hosts and open ports.
            It analyzes the network to determine if there are any vulnerabilities or threats that need to be addressed.
        </p>
        <input placeholder="192.168.1.0/24">
        <button>Scan</button>
    </div>
    <script>
        async function scanSystem() {
            let target = document.getElementById("targetInput").value;
            let res = document.getElementById("systemResult");
            res.innerText = "Scanning...";
            try {
                let r = await fetch("http://localhost:5000/system-scan", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ target })
                });
                res.innerText = JSON.stringify(await r.json(), null, 2);
            } catch {
                res.innerText = "Error";
            }
        }
        async function scanUrl() {
            let url = document.getElementById("urlInput").value;
            let res = document.getElementById("urlResult");
            res.innerText = "Scanning...";
            try {
                let r = await fetch("http://localhost:5000/scan", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ url })
                });
                res.innerText = JSON.stringify(await r.json(), null, 2);
            } catch {
                res.innerText = "Error";
            }
        }
        async function analyzeRisk() {
            let data = document.getElementById("scanData").value;
            let res = document.getElementById("analysisResult");
            let r = await fetch("http://localhost:5000/analyze", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ scan_data: data })
            });
            res.innerText = (await r.json()).analysis;
        }
        async function checkBreach() {
            let email = document.getElementById("emailInput").value;
            let res = document.getElementById("breachResult");
            res.innerText = "Checking...";
            try {
                let r = await fetch("http://localhost:5000/breach-check", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ email })
                });
                res.innerText = JSON.stringify(await r.json(), null, 2);
            } catch {
                res.innerText = "Error";
            }
        }
        async function scanWebsite() {
            let url = document.getElementById("websiteInput").value;
            let res = document.getElementById("websiteResult");
            let r = await fetch("http://localhost:5000/scan", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ url })
            });
            res.innerText = JSON.stringify(await r.json(), null, 2);
        }
    </script>
</body>

</html>
