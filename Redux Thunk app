//App.js
import React, { useEffect, useMemo, useCallback } from "https://esm.sh/react@18";
import { createStore, applyMiddleware } from "https://esm.sh/redux@4.2.1";
import { Provider, useDispatch, useSelector } from "https://esm.sh/react-redux@8.1.1";
import thunk from "https://esm.sh/redux-thunk@2.4.2";
const loggerMiddleware = (store) => (next) => (action) => {
  console.log("Dispatching:", action);
  const result = next(action);
  console.log("Next State:", store.getState());
  return result;
};
const initialState = {
  loading: false,
  users: [],
  error: null,
  selectedUser: null,
};
const reducer = (state = initialState, action) => {
  switch (action.type) {
    case "FETCH_USERS_REQUEST":
      return { ...state, loading: true };
    case "FETCH_USERS_SUCCESS":
      return { ...state, loading: false, users: action.payload };
    case "FETCH_USERS_ERROR":
      return { ...state, loading: false, error: action.payload };
    case "SELECT_USER":
      return { ...state, selectedUser: action.payload };
    default:
      return state;
  }
};
const store = createStore(
  reducer,
  applyMiddleware(loggerMiddleware, thunk)
);
const fetchUsers = () => {
  return async (dispatch) => {
    dispatch({ type: "FETCH_USERS_REQUEST" });
    try {
      const response = await fetch(
        "https://jsonplaceholder.typicode.com/users"
      );
      const data = await response.json();
      dispatch({
        type: "FETCH_USERS_SUCCESS",
        payload: data,
      });
    } catch (error) {
      dispatch({
        type: "FETCH_USERS_ERROR",
        payload: error.message,
      });
    }
  };
};
const Header = () => {
  console.log("Header Rendered");
  return <h1>Redux User Dashboard</h1>;
};
const Loader = () => {
  console.log("Loader Rendered");
  return <p>Loading users...</p>;
};
const ErrorMessage = ({ message }) => {
  console.log("Error Rendered");
  return <p style={{ color: "red" }}>Error: {message}</p>;
};
const UserItem = React.memo(({ user, onClick }) => {
  console.log("UserItem Rendered:", user.name);
  return (
    <li onClick={() => onClick(user)} style={{ cursor: "pointer" }}>
      {user.name}
    </li>
  );
});
const UserList = React.memo(({ users, onUserClick }) => {
  console.log("UserList Rendered");
  return (
    <ul>
      {users.map((user) => (
        <UserItem
          key={user.id}
          user={user}
          onClick={onUserClick}
        />
      ))}
    </ul>
  );
});
const UserDetails = ({ user }) => {
  if (!user) return <p>Select a user</p>;
  return (
    <div style={{ marginTop: "20px" }}>
      <h3>User Details</h3>
      <p><b>Name:</b> {user.name}</p>
      <p><b>Email:</b> {user.email}</p>
      <p><b>Phone:</b> {user.phone}</p>
    </div>
  );
};
const MainApp = () => {
  const dispatch = useDispatch();
  const { loading, users, error, selectedUser } = useSelector((state) => state);
  useEffect(() => {
    dispatch(fetchUsers());
  }, [dispatch]);
  const userCount = useMemo(() => {
    console.log("Calculating user count...");
    return users.length;
  }, [users]);
  const handleUserClick = useCallback((user) => {
    dispatch({ type: "SELECT_USER", payload: user });
  }, [dispatch]);
  return (
    <div style={{ padding: "20px" }}>
      <Header />
      {loading && <Loader />}
      {error && <ErrorMessage message={error} />}
      <h3>Total Users: {userCount}</h3>
      <UserList users={users} onUserClick={handleUserClick} />
      <UserDetails user={selectedUser} />
    </div>
  );
};
export default function App() {
  return (
    <Provider store={store}>
      <MainApp />
    </Provider>
  );
}
//index.html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Redux User Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(to right, #1e3c72, #2a5298);
      margin: 0;
      padding: 0;
      color: #333;
    }
    #root {
      max-width: 900px;
      margin: 40px auto;
      background: white;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }
    h1 {
      text-align: center;
      color: #2a5298;
    }
    button {
      padding: 8px 12px;
      border: none;
      background-color: #2a5298;
      color: white;
      border-radius: 6px;
      cursor: pointer;
    }
    button:hover {
      background-color: #1e3c72;
    }
    input {
      border: 1px solid #ccc;
      border-radius: 6px;
    }
    li:hover {
      color: #2a5298;
    }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="module">
    import React, { useEffect, useMemo, useCallback } from "https://esm.sh/react@18";
    import ReactDOM from "https://esm.sh/react-dom@18/client";
    import { createStore, applyMiddleware } from "https://esm.sh/redux@4.2.1";
    import { Provider, useDispatch, useSelector } from "https://esm.sh/react-redux@8.1.1";
    import thunk from "https://esm.sh/redux-thunk@2.4.2";
    const loggerMiddleware = (store) => (next) => (action) => {
      console.log("Dispatching:", action);
      const result = next(action);
      console.log("Next State:", store.getState());
      return result;
    };
    const initialState = {
      loading: false,
      users: [],
      error: null,
      selectedUser: null,
    };
    const reducer = (state = initialState, action) => {
      switch (action.type) {
        case "FETCH_USERS_REQUEST":
          return { ...state, loading: true };
        case "FETCH_USERS_SUCCESS":
          return { ...state, loading: false, users: action.payload };
        case "FETCH_USERS_ERROR":
          return { ...state, loading: false, error: action.payload };
        case "SELECT_USER":
          return { ...state, selectedUser: action.payload };
        default:
          return state;
      }
    };
    const store = createStore(
      reducer,
      applyMiddleware(loggerMiddleware, thunk)
    );
    const fetchUsers = () => {
      return async (dispatch) => {
        dispatch({ type: "FETCH_USERS_REQUEST" });
        try {
          const response = await fetch("https://jsonplaceholder.typicode.com/users");
          const data = await response.json();
          dispatch({ type: "FETCH_USERS_SUCCESS", payload: data });
        } catch (error) {
          dispatch({ type: "FETCH_USERS_ERROR", payload: error.message });
        }
      };
    };
    const Header = () => <h1>Redux User Dashboard</h1>;
    const Loader = () => <p>Loading users...</p>;
    const ErrorMessage = ({ message }) => (
      <p style={{ color: "red" }}>Error: {message}</p>
    );
    const UserItem = React.memo(({ user, onClick }) => (
      <li onClick={() => onClick(user)} style={{ cursor: "pointer" }}>
        {user.name}
      </li>
    ));
    const UserList = React.memo(({ users, onUserClick }) => (
      <ul>
        {users.map((user) => (
          <UserItem key={user.id} user={user} onClick={onUserClick} />
        ))}
      </ul>
    ));
    const UserDetails = ({ user }) => {
      if (!user) return <p>Select a user</p>;
      return (
        <div style={{ marginTop: "20px" }}>
          <h3>User Details</h3>
          <p><b>Name:</b> {user.name}</p>
          <p><b>Email:</b> {user.email}</p>
          <p><b>Phone:</b> {user.phone}</p>
        </div>
      );
    };
    const SearchBar = React.memo(({ onSearch }) => (
      <input
        type="text"
        placeholder="Search users..."
        onChange={(e) => onSearch(e.target.value)}
      />
    ));
    const UserStats = ({ users }) => {
      const stats = useMemo(() => ({
        total: users.length,
        emailsWithDotCom: users.filter(u => u.email.includes(".com")).length,
      }), [users]);
      return (
        <div>
          <p><b>Total Users:</b> {stats.total}</p>
          <p><b>.com Emails:</b> {stats.emailsWithDotCom}</p>
        </div>
      );
    };
    const RefreshButton = () => {
      const dispatch = useDispatch();
      return (
        <button onClick={() => dispatch(fetchUsers())}>
          🔄 Refresh Users
        </button>
      );
    };
    const UserCard = React.memo(({ user, onClick }) => (
      <div onClick={() => onClick(user)} style={{
        border: "1px solid #ccc",
        padding: "10px",
        margin: "5px",
        borderRadius: "8px",
        cursor: "pointer",
        width: "200px"
      }}>
        <h4>{user.name}</h4>
        <p>{user.email}</p>
      </div>
    ));
    const UserGrid = React.memo(({ users, onUserClick }) => (
      <div style={{ display: "flex", flexWrap: "wrap" }}>
        {users.map(user => (
          <UserCard key={user.id} user={user} onClick={onUserClick} />
        ))}
      </div>
    ));
    const ViewToggle = ({ setView }) => (
      <div>
        <button onClick={() => setView("list")}>List</button>
        <button onClick={() => setView("grid")}>Grid</button>
      </div>
    );
    const MainApp = () => {
      const dispatch = useDispatch();
      const { loading, users, error, selectedUser } = useSelector(s => s);
      const [search, setSearch] = React.useState("");
      const [view, setView] = React.useState("list");
      useEffect(() => {
        dispatch(fetchUsers());
      }, [dispatch]);
      const filteredUsers = useMemo(() =>
        users.filter(u =>
          u.name.toLowerCase().includes(search.toLowerCase())
        ), [users, search]
      );
      const handleUserClick = useCallback((user) => {
        dispatch({ type: "SELECT_USER", payload: user });
      }, [dispatch]);
      return (
        <div>
          <Header />
          <RefreshButton />
          <SearchBar onSearch={setSearch} />
          <ViewToggle setView={setView} />
          {loading && <Loader />}
          {error && <ErrorMessage message={error} />}

          <UserStats users={filteredUsers} />
          {view === "list"
            ? <UserList users={filteredUsers} onUserClick={handleUserClick} />
            : <UserGrid users={filteredUsers} onUserClick={handleUserClick} />
          }
          <UserDetails user={selectedUser} />
        </div>
      );
    };
    const App = () => (
      <Provider store={store}>
        <MainApp />
      </Provider>
    );
    const root = ReactDOM.createRoot(document.getElementById("root"));
    root.render(<App />);
  </script>
</body>
</html>
