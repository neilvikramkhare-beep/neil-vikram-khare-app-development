from flask import Flask, request, jsonify
from flask_limiter import Limiter
from flask_limiter.util import get_remote_address
from flask_cors import CORS
from sqlalchemy import create_engine, Column, Integer, String
from sqlalchemy.orm import declarative_base, sessionmaker
from config import Config
from utils.scanner import scan_website
from utils.risk_ai import ai_risk_analysis
from utils.breach import check_breach
import datetime
app = Flask(__name__)
app.config.from_object(Config)
CORS(app)
limiter = Limiter(get_remote_address, app=app, default_limits=["10 per minute"])
engine = create_engine(app.config["SQLALCHEMY_DATABASE_URI"])
Base = declarative_base()
class ScanLog(Base):
    __tablename__ = "scan_logs"
    id = Column(Integer, primary_key=True)
    domain = Column(String)
    score = Column(Integer)
    severity = Column(String)
    timestamp = Column(String)
Base.metadata.create_all(engine)
Session = sessionmaker(bind=engine)
def calculate_score(results):
    score = 100
    if not results["ssl_valid"]:
        score -= 30
    score -= len(results["missing_headers"]) * 5
    score -= len(results["open_ports"]) * 3
    return max(score, 0)
def severity_level(score):
    if score >= 80: return "Low"
    if score >= 60: return "Medium"
    if score >= 40: return "High"
    return "Critical"
@app.route("/scan", methods=["POST"])
@limiter.limit("5 per minute")
def scan():
    data = request.get_json()
    url = data.get("url")
    if not url:
        return jsonify({"error": "URL required"}), 400
    results = scan_website(url)
    breach_report = check_breach(url)
    score = calculate_score(results)
    severity = severity_level(score)
    ai_analysis = ai_risk_analysis(results)
    session = Session()
    log = ScanLog(
        domain=url,
        score=score,
        severity=severity,
        timestamp=str(datetime.datetime.utcnow())
    )
    session.add(log)
    session.commit()
    session.close()
    return jsonify({
        "score": score,
        "severity": severity,
        "site_result": str(results),
        "report": breach_report,
        "ai_analysis": ai_analysis
    })
@app.route("/analytics")
def analytics():
    session = Session()
    logs = session.query(ScanLog).all()
    session.close()
    data = [{
        "domain": l.domain,
        "score": l.score,
        "severity": l.severity,
        "timestamp": l.timestamp
    } for l in logs]
    return jsonify(data)
if __name__ == "__main__":
    app.run()
