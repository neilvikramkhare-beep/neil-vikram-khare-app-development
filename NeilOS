import org.springframework.web.bind.annotation.*;
import java.util.*;

@RestController
public class Backend {

    Map<String,String> users = new HashMap<>();
    double balance = 1000;
    List<String> chat = new ArrayList<>();

    @PostMapping("/register")
    public Map<String,String> register(@RequestBody Map<String,String> d){
        users.put(d.get("username"), d.get("password"));
        return Map.of("message","Registered");
    }

    @PostMapping("/login")
    public Map<String,Boolean> login(@RequestBody Map<String,String> d){
        boolean ok = users.containsKey(d.get("username")) &&
                     users.get(d.get("username")).equals(d.get("password"));
        return Map.of("success", ok);
    }

    @GetMapping("/balance")
    public Map<String,Double> balance(){
        return Map.of("balance", balance);
    }

    @PostMapping("/deposit")
    public Map<String,Double> deposit(@RequestBody Map<String,Double> d){
        balance += d.get("amount");
        return balance();
    }

    @PostMapping("/withdraw")
    public Map<String,Double> withdraw(@RequestBody Map<String,Double> d){
        if(balance >= d.get("amount")) balance -= d.get("amount");
        return balance();
    }

    @PostMapping("/chat")
    public Map<String,String> chat(@RequestBody Map<String,String> d){
        chat.add(d.get("message"));
        return Map.of("message","Sent");
    }

    @GetMapping("/chat")
    public List<String> getChat(){
        return chat;
    }
}
