//App.js
import React, { useState } from "react";
import Header from "./Header";
import Child from "./Child";
import "./App.css";
function App() {
  const [message, setMessage] = useState("Hello from Parent");
  const updateMessage = (newMsg) => {
    setMessage(newMsg);
  };
  return (
    <div className="container text-center mt-4">
      <Header />
      <h2 className="text-primary">Parent Component</h2>
      <p className="lead">Message: {message}</p>
      <Child updateMessage={updateMessage} />
    </div>
  );
}
export default App;
//Child.js
import React, { useState } from "react";

function Child({ updateMessage }) {
  const [input, setInput] = useState("");
  const handleChange = (e) => {
    setInput(e.target.value);
  };
  const sendDataToParent = () => {
    updateMessage(input);
    setInput("");
  };
  return (
    <div className="card p-3 mt-3">
      <h4 className="text-success">Child Component</h4>
      <input
        type="text"
        className="form-control mb-2"
        placeholder="Enter new message"
        value={input}
        onChange={handleChange}
        />
      <button className="btn btn-primary" onClick={sendDataToParent}>
        Update Parent Message
      </button>
    </div>
  );
}
export default Child;
