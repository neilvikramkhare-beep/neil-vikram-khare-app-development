#server.py
from flask import Flask, request, jsonify
import sqlite3
import requests
from bs4 import BeautifulSoup

app = Flask(__name__)

def db():
    return sqlite3.connect("neilos.db")

# -------- AUTH --------
@app.route("/register", methods=["POST"])
def register():
    d = request.json
    conn = db()
    conn.execute("INSERT INTO users VALUES(NULL,?,?)", (d["username"], d["password"]))
    conn.commit()
    return jsonify(message="Registered")

@app.route("/login", methods=["POST"])
def login():
    d = request.json
    cur = db().execute("SELECT password FROM users WHERE username=?", (d["username"],))
    row = cur.fetchone()
    return jsonify(success=(row and row[0] == d["password"]))

# -------- PATIENT --------
@app.route("/patient", methods=["POST"])
def patient():
    d = request.json
    db().execute("INSERT INTO patients(data) VALUES(?)", (str(d),))
    db().commit()
    return jsonify(message="Saved")

# -------- BANK --------
@app.route("/balance")
def balance():
    cur = db().execute("SELECT balance FROM bank WHERE id=1")
    return jsonify(balance=cur.fetchone()[0])

@app.route("/deposit", methods=["POST"])
def deposit():
    amt = float(request.json["amount"])
    db().execute("UPDATE bank SET balance = balance + ?", (amt,))
    db().commit()
    return balance()

@app.route("/withdraw", methods=["POST"])
def withdraw():
    amt = float(request.json["amount"])
    cur = db().execute("SELECT balance FROM bank WHERE id=1")
    bal = cur.fetchone()[0]

    if bal >= amt:
        db().execute("UPDATE bank SET balance = balance - ?", (amt,))
        db().commit()
        return balance()
    return jsonify(error="Insufficient")

# -------- EMPLOYEE --------
@app.route("/employee/add", methods=["POST"])
def emp_add():
    d = request.json
    db().execute("INSERT INTO employees(name,salary,data) VALUES(?,?,?)",
                 (d["name"], d["salary"], str(d)))
    db().commit()
    return jsonify(message="Added")

@app.route("/employee")
def emp_get():
    cur = db().execute("SELECT name,salary FROM employees")
    return jsonify([{"name":r[0],"salary":r[1]} for r in cur.fetchall()])

# -------- CHAT --------
@app.route("/chat", methods=["POST"])
def chat():
    msg = request.json["message"]
    db().execute("INSERT INTO messages(message) VALUES(?)", (msg,))
    db().commit()
    return jsonify(message="Sent")

@app.route("/chat")
def get_chat():
    cur = db().execute("SELECT message FROM messages")
    return jsonify([r[0] for r in cur.fetchall()])

# -------- SEARCH --------
@app.route("/search")
def search():
    q = request.args.get("q")
    html = requests.get("https://html.duckduckgo.com/html/?q="+q).text
    soup = BeautifulSoup(html, "html.parser")

    results = []
    for a in soup.select(".result__a"):
        results.append({"title": a.text, "link": a["href"]})

    return jsonify(results)

app.run(port=5002)
