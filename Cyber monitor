import socket
import ssl
import datetime
import requests
from urllib.parse import urlparse
def scan_website(url):
    parsed = urlparse(url)
    hostname = parsed.hostname
    results = {}
    try:
        context = ssl.create_default_context()
        with socket.create_connection((hostname, 443), timeout=5) as sock:
            with context.wrap_socket(sock, server_hostname=hostname) as ssock:
                cert = ssock.getpeercert()
                expiry = datetime.datetime.strptime(
                    cert["notAfter"], "%b %d %H:%M:%S %Y %Z"
                )
                results["ssl_valid"] = True
                results["ssl_expires_days"] = (expiry - datetime.datetime.utcnow()).days
    except:
        results["ssl_valid"] = False
    try:
        r = requests.get(url, timeout=5)
        headers = r.headers
        missing = []
        important = [
            "Strict-Transport-Security",
            "Content-Security-Policy",
            "X-Frame-Options",
            "X-Content-Type-Options"
        ]
        for h in important:
            if h not in headers:
                missing.append(h)
        results["missing_headers"] = missing
    except:
        results["missing_headers"] = ["Header scan failed"]
    open_ports = []
    for port in [21,22,23,80,443,3306]:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(1)
        if s.connect_ex((hostname, port)) == 0:
            open_ports.append(port)
        s.close()
    results["open_ports"] = open_ports
    return results
