import React, { useState } from 'react';
import UserCard from './UserCard';
function App() {
  const [user, setUser] = useState({ name: "John Rodhes", age: 35 });
  const updateAge = () => {
    setUser({ ...user, age: user.age + 1 });
  };
  return (
    <div className="container">
      <h2 className="text-center">
        React Props and State Example
      </h2>
      <UserCard userName={user.name} userAge={user.age} />
      <div className="text-center">
        <button className="btn btn-primary" onClick={updateAge}>
          Increase Age
        </button>
      </div>
    </div>
  );
}
export default App;
