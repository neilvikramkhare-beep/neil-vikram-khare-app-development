#include "crow_all.h"
#include <vector>
#include <string>

int main() {
    crow::SimpleApp app;

    double balance = 1000;
    std::vector<std::string> chat;

    CROW_ROUTE(app, "/balance")
    ([](){
        crow::json::wvalue x;
        x["balance"] = 1000;
        return x;
    });

    CROW_ROUTE(app, "/deposit").methods("POST"_method)
    ([&balance](const crow::request& req){
        auto data = crow::json::load(req.body);
        balance += data["amount"].d();
        crow::json::wvalue x;
        x["balance"] = balance;
        return x;
    });

    CROW_ROUTE(app, "/chat").methods("POST"_method)
    ([&chat](const crow::request& req){
        auto data = crow::json::load(req.body);
        chat.push_back(data["message"].s());
        return crow::response("Sent");
    });

    app.port(5002).multithreaded().run();
}
